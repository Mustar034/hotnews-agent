# ===== HotNews 环境变量模板 =====
# 复制为 .env 后填写（.env 已被 gitignore，不会提交）

# --- DeepSeek API（必需）---
# 在 https://platform.deepseek.com 创建 API Key
LLM_API_KEY=sk-你的key

# --- 可选：微博 / 知乎热榜（需登录态 Cookie，大陆网络通常不可用）---
# WEIBO_COOKIE=
# ZHIHU_COOKIE=

# --- 可选：QQ 官方机器人（单聊对话 + 每日速递）---
# 获取：QQ 开放平台（q.qq.com）→ QQ 账号登录 → 注册开发者（实名）→ 创建机器人
# 创建后到「开发设置」页复制 AppID 和 AppSecret
QQ_APP_ID=
QQ_APP_SECRET=
# 速递推送对象（可选）：在 QQ 里给机器人发一条消息即可自动绑定，无需手动填
# QQ_TARGET_OPENID=
