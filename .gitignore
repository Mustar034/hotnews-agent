# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 环境变量（可能包含 API Key）；.env.example 是模板，保留入库
.env
.env.*
!.env.example

# 运行时生成的调研报告（*.md 但保留 README）
*.md
!README.md
!hotnews/README.md
!scripts/deploy_server.md

# 会话记录（每次对话的 markdown 存档）
conversations/

# 测试文件（不入库）
tests/

# 运行时数据（QQ openid 绑定等）；seen_brief.json 需入库（跨天去重状态）
data/*
!data/seen_brief.json

# botpy SDK 运行时日志
botpy.log*

# 前端依赖与构建产物
web/node_modules/
web/dist/

# 临时文件
*.log
tmp/
